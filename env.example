# Google Cloud OAuth Configuration
# Set to true to use Desktop OAuth credentials (client_secret_desktop.json)
# Set to false (or omit) to use Web OAuth credentials (client_secrets.json)
# Desktop OAuth is recommended for WSL/headless environments
USE_DESKTOP_OAUTH=false

# Path to your Google OAuth client secrets JSON file
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_CONFIG=credentials/client_secrets.json

# Path where OAuth tokens will be stored (auto-generated after first auth)
GOOGLE_TOKEN_FILE=.gcp-saved-tokens.json

# Port for OAuth callback during authentication
GOOGLE_OAUTH_PORT=8765

# Shared Drives (formerly Team Drives) support
# Set to false to disable Shared Drives access
ENABLE_SHARED_DRIVES=true

# Directory where downloaded files will be stored
DOWNLOAD_DIRECTORY=downloads

# Maximum file size in MB to download (0 for no limit)
MAX_FILE_SIZE_MB=100

# Enable logging to file (logs.txt)
# Set to true to enable logging, false to disable
ENABLE_LOGGING=false

